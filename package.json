{
  "name": "babycity",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/adapters/node/main.js",
    "dev": "node --watch src/adapters/node/main.js",
    "test": "node --test tests/api/*.test.mjs",
    "test:browser": "playwright test",
    "backup": "node scripts/backup.mjs",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:upload-pdfs": "node scripts/upload-catalogs-r2.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "page-flip": "^2.0.7"
  }
}
