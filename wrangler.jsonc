{
  "name": "babycity",
  "main": "src/adapters/cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Creo estos recursos en el primer despliegue; no necesito IDs.
  "d1_databases": [{ "binding": "DB", "database_name": "babycity-db" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "babycity-files" }],
  "vars": {
    // Escribo aquí el dominio definitivo, sin barra final.
    "SITE_URL": ""
  }
}
