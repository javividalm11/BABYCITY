{
  "name": "babycity",
  "main": "src/adapters/cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Creo la base de datos en el primer despliegue; no necesito IDs.
  "d1_databases": [{ "binding": "DB", "database_name": "babycity-db" }],
  // Para usar R2 en lugar de Supabase, activo R2 en la cuenta y quito el comentario de esta línea.
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "babycity-files" }],
  "vars": {
    // Escribo aquí el dominio definitivo, sin barra final.
    "SITE_URL": "",
    // Dirección del proyecto de Supabase; la clave SUPABASE_SERVICE_KEY va como secreto, nunca aquí.
    "SUPABASE_URL": "https://arodfjzouzuiyahlgxoj.supabase.co",
    "SUPABASE_BUCKET": "babycity-files"
  }
}
